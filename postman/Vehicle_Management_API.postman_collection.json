{
  "info": {
    "_postman_id": "c1f7a4b2-9a84-482f-8d99-vehicle-svc",
    "name": "Vehicle Records Management API",
    "description": "Comprehensive REST API Collection for Vehicle Records Management application.\nIncludes all CRUD endpoints, validation tests, status updates, and summary metrics.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/api/vehicles",
      "type": "string"
    },
    {
      "key": "createdVehicleId",
      "value": "1",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. GET All Vehicles",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}",
          "host": ["{{baseUrl}}"]
        },
        "description": "Fetch all vehicles currently stored in the MySQL database."
      },
      "response": []
    },
    {
      "name": "2. GET Filter & Search Vehicles",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}?search=Honda&status=Available&type=Sedan",
          "host": ["{{baseUrl}}"],
          "query": [
            {
              "key": "search",
              "value": "Honda",
              "description": "Search keyword matching make, model, VIN, plate, owner"
            },
            {
              "key": "status",
              "value": "Available",
              "description": "Filter by status: Available, In Service, Reserved, Sold"
            },
            {
              "key": "type",
              "value": "Sedan",
              "description": "Filter by vehicle type: Sedan, SUV, Truck, Electric, etc."
            }
          ]
        },
        "description": "Search vehicles with keyword query and status/type filters."
      },
      "response": []
    },
    {
      "name": "3. GET Vehicle by ID",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/1",
          "host": ["{{baseUrl}}"],
          "path": ["1"]
        },
        "description": "Fetch a specific vehicle by its database primary key ID."
      },
      "response": []
    },
    {
      "name": "4. GET Vehicle by VIN",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/vin/1HGCR2F83HA123456",
          "host": ["{{baseUrl}}"],
          "path": ["vin", "1HGCR2F83HA123456"]
        },
        "description": "Fetch vehicle record by unique Vehicle Identification Number (VIN)."
      },
      "response": []
    },
    {
      "name": "5. GET Inventory Summary",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/summary",
          "host": ["{{baseUrl}}"],
          "path": ["summary"]
        },
        "description": "Fetch fleet metrics: total counts, counts by status, inventory valuation, and breakdown by vehicle type."
      },
      "response": []
    },
    {
      "name": "6. POST Create New Vehicle",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code === 201) {",
              "    var jsonData = pm.response.json();",
              "    pm.collectionVariables.set('createdVehicleId', jsonData.id);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"vin\": \"3VW2B7AJ9KM654321\",\n  \"make\": \"Volkswagen\",\n  \"model\": \"Jetta GLI\",\n  \"year\": 2024,\n  \"color\": \"Pure Gray\",\n  \"licensePlate\": \"KA01-ZX-4321\",\n  \"vehicleType\": \"Sedan\",\n  \"mileage\": 3500,\n  \"price\": 31500.00,\n  \"status\": \"Available\",\n  \"ownerName\": \"Deepak Joshi\",\n  \"ownerContact\": \"+91 98888 11223\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}",
          "host": ["{{baseUrl}}"]
        },
        "description": "Create a new vehicle record in the MySQL database. Checks for duplicate VIN and license plate."
      },
      "response": []
    },
    {
      "name": "7. PUT Update Vehicle by ID",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"vin\": \"3VW2B7AJ9KM654321\",\n  \"make\": \"Volkswagen\",\n  \"model\": \"Jetta GLI Autobahn\",\n  \"year\": 2024,\n  \"color\": \"Pure Gray Metallic\",\n  \"licensePlate\": \"KA01-ZX-4321\",\n  \"vehicleType\": \"Sedan\",\n  \"mileage\": 4200,\n  \"price\": 32000.00,\n  \"status\": \"Reserved\",\n  \"ownerName\": \"Deepak Joshi\",\n  \"ownerContact\": \"+91 98888 11223\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/{{createdVehicleId}}",
          "host": ["{{baseUrl}}"],
          "path": ["{{createdVehicleId}}"]
        },
        "description": "Full update of an existing vehicle record."
      },
      "response": []
    },
    {
      "name": "8. PATCH Update Vehicle Status",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"Sold\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/{{createdVehicleId}}/status",
          "host": ["{{baseUrl}}"],
          "path": ["{{createdVehicleId}}", "status"]
        },
        "description": "Quick status transition for a vehicle (e.g. Available -> Sold)."
      },
      "response": []
    },
    {
      "name": "9. DELETE Vehicle by ID",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/{{createdVehicleId}}",
          "host": ["{{baseUrl}}"],
          "path": ["{{createdVehicleId}}"]
        },
        "description": "Delete vehicle record from MySQL database."
      },
      "response": []
    },
    {
      "name": "10. Validation Failure Test (POST invalid)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"vin\": \"\",\n  \"make\": \"\",\n  \"year\": 1800\n}"
        },
        "url": {
          "raw": "{{baseUrl}}",
          "host": ["{{baseUrl}}"]
        },
        "description": "Demonstrates 400 Bad Request error response with detailed field validation messages."
      },
      "response": []
    }
  ]
}
