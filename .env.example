# ==============================================================================
# Full-Stack Deployment Environment Variables Example
# DO NOT COMMIT SENSITIVE PASSWORDS TO SOURCE CONTROL
# ==============================================================================

# ------------------------------------------------------------------------------
# RENDER BACKEND ENVIRONMENT VARIABLES (Set in Render Dashboard -> Environment)
# ------------------------------------------------------------------------------
# Render Managed PostgreSQL JDBC URL
SPRING_DATASOURCE_URL=jdbc:postgresql://dpg-your-db-host.oregon-postgres.render.com:5432/vehicle_db
SPRING_DATASOURCE_USERNAME=vehicle_db_user
SPRING_DATASOURCE_PASSWORD=your_database_password

# CORS: Add your Vercel frontend URL here
CORS_ALLOWED_ORIGINS=https://your-frontend.vercel.app,http://localhost:3000
HIBERNATE_DDL_AUTO=update

# ------------------------------------------------------------------------------
# VERCEL FRONTEND ENVIRONMENT VARIABLES (Set in Vercel Dashboard -> Environment)
# ------------------------------------------------------------------------------
# Set this to your live Render backend URL
VITE_API_BASE_URL=https://your-backend.onrender.com
