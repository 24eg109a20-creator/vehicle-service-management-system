# ==============================================================================
# Spring Boot Backend Environment Variables (Render Deployment)
# Set these in: Render Dashboard -> Your Web Service -> Environment
# ==============================================================================

# ------------------------------------------------------------------------------
# DATABASE SETTINGS
# ------------------------------------------------------------------------------
# Option A: Render Managed PostgreSQL Database (Recommended on Render)
# Format: jdbc:postgresql://<HOSTNAME>:5432/<DATABASE_NAME>
SPRING_DATASOURCE_URL=jdbc:postgresql://dpg-your-db-host.oregon-postgres.render.com:5432/vehicle_db
SPRING_DATASOURCE_USERNAME=vehicle_db_user
SPRING_DATASOURCE_PASSWORD=your_database_password

# Option B: External Hosted MySQL (Aiven, TiDB Cloud, Clever Cloud)
# SPRING_DATASOURCE_URL=jdbc:mysql://your-mysql-host:3306/vehicle_db?useSSL=true&serverTimezone=UTC
# SPRING_DATASOURCE_USERNAME=your_mysql_user
# SPRING_DATASOURCE_PASSWORD=your_mysql_password

# ------------------------------------------------------------------------------
# SECURITY & CORS
# ------------------------------------------------------------------------------
# Put your deployed Vercel frontend URL here (comma-separated if multiple)
CORS_ALLOWED_ORIGINS=https://your-frontend.vercel.app,http://localhost:3000

# ------------------------------------------------------------------------------
# APPLICATION SETTINGS
# ------------------------------------------------------------------------------
# Render automatically sets PORT (e.g. 10000). Leave unset in Render dashboard.
PORT=8080
HIBERNATE_DDL_AUTO=update
SHOW_SQL=false
